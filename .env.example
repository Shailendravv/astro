# Copy to .env with scripts\init-env.ps1 (never commit .env). Secrets and model IDs have NO value here.
# See docs/deployment.md section 4. There is no Anthropic setting: the product uses no Anthropic model (D-030).

APP_ENV=local-prod
LOG_LEVEL=INFO

# Host ports (always bound to 127.0.0.1 in docker-compose.yml). Use other ports for the dev project.
API_PORT=8000
WEB_PORT=3000

# Database (the password is generated by scripts\init-env.ps1)
POSTGRES_PASSWORD=
POSTGRES_USER=jyotish
POSTGRES_DB=jyotish

# CORS / Host-header allow lists (must match the ports above)
ALLOWED_ORIGINS=http://127.0.0.1:3000
ALLOWED_HOSTS=127.0.0.1,localhost
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# Library and data locations (used from M2/M4)
LIBRARY_ROOT=
EPHE_PATH=
TZDATA_VERSION_PIN=
EMBEDDING_MODEL=

# AI features stay disabled while RUNTIME_MODEL_ID is empty (D-012, D-030).
# Set RUNTIME_MODEL_ID only to the ID recorded in the decisions.md model register.
GROQ_API_KEY=
RUNTIME_PROVIDER=
RUNTIME_MODEL_ID=
PROMPT_SET=v1

# Evaluation judge: the owner proposed the same Groq model as the runtime (Q-018), so every run is
# self-judged. Leave empty until the first-real-call gate in docs/security.md section 4 is approved.
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL_ID=

# Backups (the passphrase is NOT stored here; see docs/security.md section 5)
BACKUP_DIR=
